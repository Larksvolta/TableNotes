<UserControl x:Class="TableNotes.Views.NotePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListView x:Name="NotesList"
                  ItemsSource="{Binding Notes}"
                  SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                  SelectionMode="Single"
                  BorderThickness="0,0,1,0"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{Binding ModifiedAt}"
                                   Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TreeView x:Name="NotesTree"
                  BorderThickness="0,0,1,0"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>

        <Grid Grid.Column="1">
            <Button x:Name="ToggleBtn" Width="20" Height="64"
                    VerticalAlignment="Center" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Click="OnToggleSidebar">
                <SymbolIcon Symbol="ClosePane"/>
            </Button>
        </Grid>

        <Grid Grid.Column="2" Padding="12">
            <StackPanel Spacing="8">
                <TextBox x:Name="TitleBox"
                         PlaceholderText="Title" FontSize="20" FontWeight="SemiBold"
                         Text="{Binding EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0" Background="Transparent"
                         TextWrapping="NoWrap"/>

                <Grid x:Name="TableViewContainer" MinHeight="200"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding NewNoteCommand}" Content="+" FontSize="18"
                            Width="36" Height="36" Padding="0"/>
                    <Button Command="{Binding SaveNoteCommand}" Content="Save"
                            Style="{StaticResource AccentButtonStyle}"/>
                    <Button Command="{Binding DeleteNoteCommand}" Content="Delete"/>
                    <Button Command="{Binding AddRowCommand}" Content="Add Row"/>
                </StackPanel>

                <InfoBar Message="{Binding StatusMessage}"
                         IsOpen="{Binding HasStatusMessage}"
                         Severity="Success" IsClosable="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>